<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitGem">

        <!-- ─── SPLASH SCREEN (Launcher Entry Point) ─── -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ─── MAIN ACTIVITY (Redirect helper) ─── -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 1. LOGIN SCREEN ─── -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 2. SIGN UP SCREEN ─── -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 3. DASHBOARD / HOME SCREEN ─── -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 4. PROGRESS SCREEN ─── -->
        <activity
            android:name=".ProgressActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 5. WORKOUT PLANS SCREEN ─── -->
        <activity
            android:name=".WorkoutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 6. WORKOUT DETAILS SCREEN ─── -->
        <activity
            android:name=".WorkoutDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 7. DIET PLAN SCREEN ─── -->
        <activity
            android:name=".DietActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 8. BMI CALCULATOR SCREEN ─── -->
        <activity
            android:name=".BmiActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 9. BODY MEASUREMENTS SCREEN ─── -->
        <activity
            android:name=".BodyMeasurementsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 10. PROFILE SCREEN ─── -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 11. SETTINGS SCREEN ─── -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 12. ACTIVE WORKOUT SCREEN ─── -->
        <activity
            android:name=".ActiveWorkoutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 13. EDIT PROFILE SCREEN ─── -->
        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ─── 14. GOALS SCREEN ─── -->
        <activity
            android:name=".GoalsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>